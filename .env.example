# Local-only credentials for this POC. Not for a shared environment.
# scripts/up.sh copies this file to .env on first run. .env is not committed.

POSTGRES_PORT=5432
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=postgres_local_only
DATABASE_NAME=appdb

MIGRATION_USERNAME=liquibase_admin
MIGRATION_PASSWORD=liquibase_local_only

APP_USERNAME=app_user
APP_PASSWORD=app_user_local_only

LIMITED_USERNAME=liquibase_limited
LIMITED_PASSWORD=limited_local_only
