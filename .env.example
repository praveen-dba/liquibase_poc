# Copy to .env for a local run. .env is not committed.
# A Jenkins job does not need this file. Export LIQUIBASE_COMMAND_URL,
# LIQUIBASE_COMMAND_USERNAME, and LIQUIBASE_COMMAND_PASSWORD on the job.
# A value already set in the environment wins over this file.
#
# PostgreSQL: the URL selects the database. SCHEMA (default app) is the schema inside it.
# MySQL: the URL database and SCHEMA should be the same name. Default is app.
# MongoDB: the URL selects the database. Leave the username empty when the local server has no auth.

POSTGRES_URL=jdbc:postgresql://localhost:5432/app
POSTGRES_USERNAME=liquibase
POSTGRES_PASSWORD=

MYSQL_URL=jdbc:mysql://localhost:3306/app?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
MYSQL_USERNAME=liquibase
MYSQL_PASSWORD=

MONGODB_URL=mongodb://localhost:27017/app
MONGODB_USERNAME=
MONGODB_PASSWORD=
